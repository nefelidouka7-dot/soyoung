# Database
# Local Postgres:
DATABASE_URL="postgresql://soyoung:soyoung@localhost:5432/soyoung?schema=public"
# Local Homebrew example:
# DATABASE_URL="postgresql://localhost:5432/soyoung?schema=public"
#
# On Vercel + Neon integration, these are enough (no DATABASE_URL needed):
#   db_POSTGRES_PRISMA_URL
#   db_POSTGRES_URL
# The app maps db_* → DATABASE_URL automatically.

# Auth.js
AUTH_SECRET="change-me-to-a-long-random-secret-in-production"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (required in production; local mock needs ALLOW_MOCK_PAYMENTS=true)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
ALLOW_MOCK_PAYMENTS="true"

# Email (required for password-reset emails in production)
RESEND_API_KEY=""
EMAIL_FROM="SoYoung <noreply@soyoung.example>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="SoYoung"
UPLOAD_DIR="./public/uploads"
FREE_SHIPPING_THRESHOLD="50"
