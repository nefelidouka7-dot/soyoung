# Database
# Local Postgres:
DATABASE_URL="postgresql://soyoung:soyoung@localhost:5432/soyoung?schema=public"
# Local Homebrew example:
# DATABASE_URL="postgresql://localhost:5432/soyoung?schema=public"
#
# On Vercel + Neon integration, these are enough (no DATABASE_URL needed):
#   db_POSTGRES_PRISMA_URL
#   db_POSTGRES_URL
# The app maps db_* → DATABASE_URL automatically.

# Auth.js
AUTH_SECRET="change-me-to-a-long-random-secret-in-production"
# Local:
AUTH_URL="http://localhost:3000"
# On Vercel set to your deployment URL, e.g.:
# AUTH_URL="https://soyoung-tada14.vercel.app"
# AUTH_TRUST_HOST is optional when trustHost: true is set in lib/auth.ts
AUTH_TRUST_HOST="true"

# Viva.com Smart Checkout (required in production; local mock needs ALLOW_MOCK_PAYMENTS=true)
# Demo: https://demo.vivapayments.com  |  Live: https://www.vivapayments.com
VIVA_ENV="demo"
VIVA_CLIENT_ID=""
VIVA_CLIENT_SECRET=""
VIVA_SOURCE_CODE="Default"
# Needed for webhook URL verification (Merchant ID + API Key from Settings → API Access)
VIVA_MERCHANT_ID=""
VIVA_API_KEY=""
# Optional Smart Checkout brand color (hex without #)
# VIVA_CHECKOUT_COLOR="fe9875"
ALLOW_MOCK_PAYMENTS="true"

# In Viva payment source, set:
#   Success URL → https://YOUR_DOMAIN/checkout/success
#   Failure URL → https://YOUR_DOMAIN/checkout?payment=failed
# Webhook URL   → https://YOUR_DOMAIN/api/viva/webhook  (Event: Transaction Payment Created)

# Email (required for password-reset emails in production)
RESEND_API_KEY=""
EMAIL_FROM="SoYoung <noreply@soyoung.example>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="SoYoung"
UPLOAD_DIR="./public/uploads"
FREE_SHIPPING_THRESHOLD="50"

# Cloudflare R2 (optional — when set, uploads go to R2 instead of UPLOAD_DIR)
# 1. Cloudflare Dashboard → R2 → Create bucket
# 2. Manage R2 API Tokens → Create API token (Object Read & Write)
# 3. Bucket → Settings → Public access: enable r2.dev subdomain OR custom domain
# 4. Set R2_PUBLIC_URL to that public base (no trailing slash), e.g.:
#    https://pub-xxxxxxxx.r2.dev   or   https://media.yourdomain.com
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="soyoung"
# R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
# Required if the bucket was created with EU jurisdiction (common in Europe):
# R2_JURISDICTION="eu"
